{
  "name": "schoolapp",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev --filter=@schoolapp/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:setup": "node scripts/run-bash.mjs scripts/setup-db.sh",
    "db:migrate": "pnpm --filter @schoolapp/db migrate",
    "db:seed-platform": "pnpm --filter @schoolapp/db seed-platform",
    "demo:setup": "node scripts/run-bash.mjs scripts/demo-setup.sh",
    "demo:reset": "node scripts/run-bash.mjs scripts/demo-reset.sh",
    "demo:start": "pnpm --filter @schoolapp/web dev"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
