# Preferred first production region (deployment preference, not a legal hard-stop)
PREFERRED_DEPLOYMENT_REGION=uk

# Runtime DB role (NOBYPASSRLS) — used by the API
DATABASE_URL=postgres://schoolapp_app:schoolapp_app@127.0.0.1:5432/schoolapp

# Owner / migration role (BYPASSRLS) — migrations and SECURITY DEFINER owners
DATABASE_OWNER_URL=postgres://schoolapp_owner:schoolapp_owner@127.0.0.1:5432/schoolapp

AUTH_SECRET=replace-with-a-long-random-string
AUTH_TOKEN_TTL_SECONDS=900

# SaaS routing. Local default is localhost so greenwood.localhost:3000 works.
# Production must set the real apex (do not hard-code it in application code).
PLATFORM_DOMAIN=localhost

# Set true only behind a reverse proxy that OVERWRITES X-Forwarded-Host / Proto
# from the connection it terminated. Never pass through client-supplied values.
# Even then, forwarded hosts are ignored unless the immediate Host is the
# proxy/origin terminator (IP, localhost, platform apex, or reserved label).
# Default false: X-Forwarded-Host is ignored (prevents Host-header spoofing).
TRUST_PROXY=false

# Optional: override package test DBs (defaults are schoolapp_test / schoolapp_api_test)
# TEST_DATABASE_URL=postgres://schoolapp_app:schoolapp_app@127.0.0.1:5432/schoolapp_test
# TEST_DATABASE_OWNER_URL=postgres://schoolapp_owner:schoolapp_owner@127.0.0.1:5432/schoolapp_test

# Optional bootstrap (scripts)
PLATFORM_ADMIN_EMAIL=platform@example.com
PLATFORM_ADMIN_PASSWORD=change-me
PLATFORM_ADMIN_NAME="Platform Admin"

# Local demo only. `pnpm demo:setup` sets this to true in your private .env.
# Never set ALLOW_DEMO_SEED=true in production. Demo seed also requires
# PLATFORM_DOMAIN=localhost and a loopback Postgres URL.
# ALLOW_DEMO_SEED=false

# Public admissions forms. Leave as none unless a captcha adapter is configured.
# PUBLIC_FORM_CAPTCHA_PROVIDER=none

# Object storage. Demo/local default is the filesystem adapter (no cloud account).
# School logos/covers and profile photos use this same store.
#
# Development/test: OBJECT_STORAGE_FS_ROOT may be relative (e.g. .data/object-storage).
# If unset, the filesystem adapter uses a local temp directory (not for production).
#
# Production (NODE_ENV=production) + OBJECT_STORAGE_DRIVER=filesystem:
# OBJECT_STORAGE_FS_ROOT is required and must be an absolute persistent path.
# Startup fails closed if it is missing, relative, under /tmp, or inside the
# application/deploy working directory (Plesk Git may replace that tree).
# Do not use /tmp, .next, public, or a path inside the Git checkout / httpdocs.
# See docs/storage.md. S3 remains optional and is not required.
OBJECT_STORAGE_DRIVER=filesystem
OBJECT_STORAGE_FS_ROOT=.data/object-storage
# OBJECT_STORAGE_MAX_BYTES_STANDARD=10485760
# OBJECT_STORAGE_MAX_BYTES_LEARNING=20971520
# OBJECT_STORAGE_MAX_BYTES_ADMISSIONS=8388608
# OBJECT_STORAGE_MAX_BYTES_PASTORAL=10485760
# OBJECT_STORAGE_MAX_BYTES_SAFEGUARDING=15728640
# OBJECT_STORAGE_MAX_BYTES_PROFILE_PHOTO=2097152
# FILE_SCANNER_DRIVER=noop

# School payments. Local demo/CI default is the fake provider (no Stripe account).
# Production multi-tenant Stripe keys are stored per school (encrypted), not here.
# Do not put a school's Stripe secret key in these global variables.
PAYMENT_PROVIDER=fake
# FAKE_PAYMENT_WEBHOOK_SECRET=
# Required before a School Admin can save per-school Stripe credentials.
# 32-byte key as 64 hex chars, or base64 of 32 bytes. Never commit a real value.
# SCHOOLAPP_SECRETS_ENCRYPTION_KEY=
# STRIPE_SECRET_KEY=   # ignored for school payments (legacy / unit tests only)
# STRIPE_WEBHOOK_SECRET=  # ignored for school payments (legacy / unit tests only)
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_API_BASE=https://api.stripe.com

# Transactional email. Default is log-only; nothing is sent externally until
# EMAIL_DELIVERY_MODE=live, EMAIL_PROVIDER=smtp, SMTP_HOST, and EMAIL_FROM_ADDRESS
# are all set. Tests must keep EMAIL_DELIVERY_MODE=test (or inject FakeEmailProvider).
# EMAIL_PROVIDER=none
# EMAIL_DELIVERY_MODE=log
# EMAIL_FROM_ADDRESS=notifications@your-verified-domain
# EMAIL_FROM_NAME=LuvLearn
# EMAIL_REPLY_TO=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_URL=
# Optional cron credential for POST /api/v1/internal/mail/deliver
# EMAIL_WORKER_SECRET=

# S3-compatible production (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO, etc.)
# OBJECT_STORAGE_DRIVER=s3
# OBJECT_STORAGE_S3_ENDPOINT=https://s3.eu-west-2.amazonaws.com
# OBJECT_STORAGE_S3_REGION=eu-west-2
# OBJECT_STORAGE_S3_BUCKET=
# OBJECT_STORAGE_S3_ACCESS_KEY=
# OBJECT_STORAGE_S3_SECRET_KEY=
# OBJECT_STORAGE_S3_FORCE_PATH_STYLE=false
# OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=60
