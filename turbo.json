{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "AUTH_SECRET",
    "AUTH_TOKEN_TTL_SECONDS",
    "DATABASE_OWNER_URL",
    "DATABASE_URL",
    "NEXT_DIST_DIR",
    "PLATFORM_DOMAIN",
    "TEST_DATABASE_OWNER_URL",
    "TEST_DATABASE_URL",
    "TRUST_PROXY",
    "EMAIL_PROVIDER",
    "EMAIL_DELIVERY_MODE",
    "EMAIL_FROM_ADDRESS",
    "EMAIL_FROM_NAME",
    "EMAIL_REPLY_TO",
    "EMAIL_WORKER_SECRET",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USERNAME",
    "SMTP_PASSWORD",
    "SMTP_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "migrate": {
      "cache": false
    },
    "seed-platform": {
      "cache": false
    },
    "seed-demo": {
      "cache": false
    }
  }
}
