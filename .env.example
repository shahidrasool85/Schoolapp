# Preferred first production region (deployment preference, not a legal hard-stop)
PREFERRED_DEPLOYMENT_REGION=uk

# Runtime DB role (NOBYPASSRLS) — used by the API
DATABASE_URL=postgres://schoolapp_app:schoolapp_app@127.0.0.1:5432/schoolapp

# Owner / migration role (BYPASSRLS) — migrations and SECURITY DEFINER owners
DATABASE_OWNER_URL=postgres://schoolapp_owner:schoolapp_owner@127.0.0.1:5432/schoolapp

AUTH_SECRET=replace-with-a-long-random-string
AUTH_TOKEN_TTL_SECONDS=900

# SaaS routing. Local default is localhost so greenwood.localhost:3000 works.
# Production must set the real apex (do not hard-code it in application code).
PLATFORM_DOMAIN=localhost

# Set true only behind a reverse proxy that OVERWRITES X-Forwarded-Host / Proto
# from the connection it terminated. Never pass through client-supplied values.
# Even then, forwarded hosts are ignored unless the immediate Host is the
# proxy/origin terminator (IP, localhost, platform apex, or reserved label).
# Default false: X-Forwarded-Host is ignored (prevents Host-header spoofing).
TRUST_PROXY=false

# Optional: override package test DBs (defaults are schoolapp_test / schoolapp_api_test)
# TEST_DATABASE_URL=postgres://schoolapp_app:schoolapp_app@127.0.0.1:5432/schoolapp_test
# TEST_DATABASE_OWNER_URL=postgres://schoolapp_owner:schoolapp_owner@127.0.0.1:5432/schoolapp_test

# Optional bootstrap (scripts)
PLATFORM_ADMIN_EMAIL=platform@example.com
PLATFORM_ADMIN_PASSWORD=change-me
PLATFORM_ADMIN_NAME="Platform Admin"

# Local demo only. `pnpm demo:setup` sets this to true in your private .env.
# Never set ALLOW_DEMO_SEED=true in production. Demo seed also requires
# PLATFORM_DOMAIN=localhost and a loopback Postgres URL.
# ALLOW_DEMO_SEED=false

# Public admissions forms. Leave as none unless a captcha adapter is configured.
# PUBLIC_FORM_CAPTCHA_PROVIDER=none
